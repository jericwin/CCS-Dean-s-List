# Copy to .env and adjust. Never commit the real .env.
APP_ENV=development            # set to "production" in production (requires SECRET_KEY, enables secure cookies)
SECRET_KEY=change-me           # python -c "import secrets; print(secrets.token_hex(32))"
FLASK_DEBUG=                   # defaults to on in development, off in production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=student_portal
DB_POOL_SIZE=8
AUTO_MIGRATE=true              # apply additive schema upgrades on startup

HOST=127.0.0.1
PORT=5000
SESSION_HOURS=8
SESSION_COOKIE_SECURE=         # defaults to true in production
MAX_UPLOAD_MB=10
PDF_EXPORT_ENGINE=auto         # auto | docx (DL.docx via MS Word) | reportlab
FIRST_ACADEMIC_YEAR=2024
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
